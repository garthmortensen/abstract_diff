<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>{{ summary.headline }} — One-page brief</title>
<style>
  body { font-family: system-ui, sans-serif; margin: 2rem auto; max-width: 820px; line-height: 1.5; color: #1a1a1a; }
  .ai-warning { background: #fff4d6; border: 1px solid #e0b100; color: #6b4f00; padding: 0.75rem 1rem; border-radius: 6px; margin-bottom: 1.5rem; font-weight: 600; }
  .kicker { text-transform: uppercase; letter-spacing: 0.08em; font-size: 0.75rem; color: #666; margin: 0; }
  h1 { font-size: 1.9rem; line-height: 1.2; margin: 0.25rem 0 1rem; color: #111; }
  .answer { background: #f5f5f5; border-left: 5px solid #111; padding: 1rem 1.25rem; border-radius: 6px; margin-bottom: 1rem; }
  .answer .thought { font-size: 1.2rem; margin: 0 0 0.5rem; }
  .answer .recommendation { margin: 0; font-weight: 600; }
  .counts { display: flex; gap: 1.5rem; font-size: 0.85rem; color: #555; margin-bottom: 1.5rem; }
  .counts b { color: #111; font-size: 1.1rem; }
  .pillar { border: 1px solid #ddd; border-radius: 6px; padding: 1rem 1.25rem; margin-bottom: 1rem; page-break-inside: avoid; }
  .pillar h2 { font-size: 1.1rem; margin: 0 0 0.5rem; }
  .pillar h2 .n { display: inline-block; min-width: 1.6rem; color: #666; }
  .evidence { margin: 0.5rem 0 0; padding-left: 0; list-style: none; }
  .evidence li { margin: 0.5rem 0; padding-left: 0.75rem; border-left: 3px solid #ccc; }
  .evidence li.challenger { border-color: #b83280; }
  .evidence li.champion { border-color: #2b6cb0; }
  .evidence .quote { display: block; font-style: italic; }
  .evidence .why { display: block; font-size: 0.9rem; color: #444; }
  .tag { display: inline-block; font-size: 0.7rem; font-weight: 600; text-transform: uppercase; padding: 0.05rem 0.4rem; border-radius: 4px; margin-right: 0.4rem; color: #fff; background: #777; }
  .tag.challenger { background: #b83280; }
  .tag.champion { background: #2b6cb0; }
  .badge { display: inline-block; font-size: 0.7rem; font-weight: 600; padding: 0.1rem 0.4rem; border-radius: 4px; margin-left: 0.4rem; background: #ffe0e0; color: #a30000; }
  .audience { font-size: 0.9rem; color: #444; border-top: 1px solid #ddd; padding-top: 0.75rem; }
  @media print { body { margin: 0; max-width: none; } .ai-warning { border-width: 2px; } }
</style>
</head>
<body>
<div class="ai-warning">Warning: this brief was generated by an LLM from an LLM-produced comparison and may contain errors. Verify against the source papers before acting on it.</div>

<p class="kicker">Executive brief · challenger vs. champion</p>
<h1>{{ summary.headline }}</h1>

<div class="answer">
  <p class="thought">{{ summary.governing_thought }}</p>
  <p class="recommendation">{{ summary.recommendation }}</p>
</div>

<div class="counts">
  <span><b>{{ summary.counts.challenger_only }}</b> only in challenger</span>
  <span><b>{{ summary.counts.champion_only }}</b> only in champion</span>
  <span><b>{{ summary.counts.shared }}</b> shared</span>
</div>

{% for pillar in summary.pillars %}
<section class="pillar">
  <h2><span class="n">{{ loop.index }}.</span>{{ pillar.claim }}</h2>
  <ul class="evidence">
    {% for item in pillar.evidence %}
    <li class="{{ item.source }}">
      <span class="tag {{ item.source }}">{{ item.source }}</span>{% if not item.grounded %}<span class="badge">quote not found in comparison</span>{% endif %}
      <span class="quote">“{{ item.quote }}”</span>
      <span class="why">{{ item.why_it_matters }}</span>
    </li>
    {% endfor %}
  </ul>
</section>
{% endfor %}

<p class="audience"><strong>Who should care:</strong> {{ summary.who_should_care }}</p>
</body>
</html>
