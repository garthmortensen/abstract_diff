<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>{{ summary.headline }} — Decision memo</title>
<style>
  body { font-family: system-ui, sans-serif; margin: 2rem auto; max-width: 900px; line-height: 1.45; color: #1a1a1a; font-size: 0.95rem; }
  .ai-warning { background: #fff4d6; border: 1px solid #e0b100; color: #6b4f00; padding: 0.75rem 1rem; border-radius: 6px; margin-bottom: 1.5rem; font-weight: 600; }
  h1 { font-size: 1.4rem; margin: 0 0 0.75rem; text-transform: uppercase; letter-spacing: 0.04em; }
  table.header { width: 100%; border-collapse: collapse; margin-bottom: 1.5rem; }
  table.header th { text-align: left; vertical-align: top; width: 9rem; padding: 0.4rem 0.6rem; color: #555; font-weight: 600; border-bottom: 1px solid #eee; }
  table.header td { padding: 0.4rem 0.6rem; border-bottom: 1px solid #eee; }
  table.header td.bottom-line { font-size: 1.1rem; font-weight: 600; }
  h2 { font-size: 1rem; text-transform: uppercase; letter-spacing: 0.06em; color: #333; margin: 1.5rem 0 0.5rem; }
  .two-col { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
  .col { border-radius: 6px; padding: 0.75rem 1rem; }
  .col.brings { background: #fbeaf3; border-top: 4px solid #b83280; }
  .col.lacks { background: #e8f0fa; border-top: 4px solid #2b6cb0; }
  .col h3 { margin: 0 0 0.5rem; font-size: 0.9rem; }
  .col ul { margin: 0; padding-left: 1.1rem; }
  .col li { margin: 0.3rem 0; }
  ol.argument { padding-left: 1.5rem; margin: 0; }
  ol.argument > li { font-weight: 600; margin: 0.75rem 0; }
  ol.argument ol { list-style: none; padding-left: 1rem; margin: 0.35rem 0 0; font-weight: 400; }
  ol.argument ol li { margin: 0.35rem 0; padding-left: 0.6rem; border-left: 3px solid #ccc; }
  ol.argument ol li.challenger { border-color: #b83280; }
  ol.argument ol li.champion { border-color: #2b6cb0; }
  .ref { color: #666; font-size: 0.8rem; margin-right: 0.4rem; }
  .quote { font-style: italic; }
  .why { display: block; color: #444; font-size: 0.85rem; }
  .tag { display: inline-block; font-size: 0.7rem; font-weight: 600; text-transform: uppercase; padding: 0.05rem 0.4rem; border-radius: 4px; margin-right: 0.4rem; color: #fff; background: #777; }
  .tag.challenger { background: #b83280; }
  .tag.champion { background: #2b6cb0; }
  .badge { display: inline-block; font-size: 0.7rem; font-weight: 600; padding: 0.1rem 0.4rem; border-radius: 4px; margin-left: 0.4rem; background: #ffe0e0; color: #a30000; }
  .footer { color: #555; font-size: 0.85rem; border-top: 1px solid #ddd; margin-top: 1.5rem; padding-top: 0.5rem; }
</style>
</head>
<body>
<div class="ai-warning">Warning: this memo was generated by an LLM from an LLM-produced comparison and may contain errors. Verify against the source papers before acting on it.</div>

<h1>Decision memo</h1>
<table class="header">
  <tr><th>Re</th><td>{{ summary.headline }}</td></tr>
  <tr><th>Bottom line</th><td class="bottom-line">{{ summary.governing_thought }}</td></tr>
  <tr><th>Recommendation</th><td>{{ summary.recommendation }}</td></tr>
  <tr><th>Scope</th><td>{{ summary.counts.challenger_only }} assertions only in the challenger, {{ summary.counts.champion_only }} only in the champion, {{ summary.counts.shared }} shared.</td></tr>
</table>

<h2>At a glance</h2>
<div class="two-col">
  <div class="col brings">
    <h3>Challenger brings</h3>
    <ul>
      {% for item in summary.challenger_brings %}
      <li>{{ item }}</li>
      {% endfor %}
    </ul>
  </div>
  <div class="col lacks">
    <h3>Challenger lacks</h3>
    <ul>
      {% for item in summary.challenger_lacks %}
      <li>{{ item }}</li>
      {% else %}
      <li>No material gaps identified.</li>
      {% endfor %}
    </ul>
  </div>
</div>

<h2>Argument</h2>
<ol class="argument">
  {% for pillar in summary.pillars %}
  {% set pillar_number = loop.index %}
  <li>{{ pillar.claim }}
    <ol>
      {% for item in pillar.evidence %}
      <li class="{{ item.source }}">
        <span class="ref">{{ pillar_number }}.{{ loop.index }}</span>
        <span class="tag {{ item.source }}">{{ item.source }}</span>{% if not item.grounded %}<span class="badge">quote not found in comparison</span>{% endif %}
        <span class="quote">“{{ item.quote }}”</span>
        <span class="why">{{ item.why_it_matters }}</span>
      </li>
      {% endfor %}
    </ol>
  </li>
  {% endfor %}
</ol>

<p class="footer"><strong>Common ground:</strong> {{ summary.shared_ground }}<br>
<strong>Who should care:</strong> {{ summary.who_should_care }}</p>
</body>
</html>
