<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>Paper Comparison Report</title>
<style>
  body { font-family: system-ui, sans-serif; margin: 2rem auto; max-width: 960px; line-height: 1.5; color: #1a1a1a; }
  h1, h2, h3 { color: #111; }
  .metrics { display: flex; gap: 2rem; flex-wrap: wrap; background: #f5f5f5; padding: 1rem; border-radius: 6px; }
  .metric { min-width: 10rem; }
  .metric .value { font-size: 1.4rem; font-weight: 600; }
  .metric .label { font-size: 0.85rem; color: #555; }
  .section { border: 1px solid #ddd; border-radius: 6px; padding: 1rem; margin-bottom: 1rem; }
  .assertion { margin: 0.5rem 0; padding-left: 0.75rem; border-left: 3px solid #ccc; }
  .assertion .type { font-size: 0.75rem; text-transform: uppercase; color: #666; }
  .badge { display: inline-block; font-size: 0.7rem; font-weight: 600; padding: 0.1rem 0.4rem; border-radius: 4px; margin-left: 0.4rem; }
  .badge.ungrounded { background: #ffe0e0; color: #a30000; }
  .badge.corrected { background: #fff4d6; color: #8a6100; }
  .record { border: 1px solid #ddd; border-radius: 6px; padding: 0.75rem 1rem; margin-bottom: 0.75rem; }
  .record .interpretation { color: #333; font-style: italic; }
  .quote { display: block; margin: 0.25rem 0; }
  .quote.a { border-left: 3px solid #2b6cb0; padding-left: 0.5rem; }
  .quote.b { border-left: 3px solid #b83280; padding-left: 0.5rem; }
  .similarity { font-size: 0.8rem; color: #555; }
  .two-col { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; }
  details.venn { border: 1px solid #ddd; border-radius: 6px; padding: 0.75rem 1rem; margin-bottom: 1rem; }
  details.venn > summary { cursor: pointer; font-size: 1.3rem; font-weight: 600; color: #111; }
  details.venn > summary .count { font-size: 1rem; font-weight: 400; color: #555; }
  .ai-warning { background: #fff4d6; border: 1px solid #e0b100; color: #6b4f00; padding: 0.75rem 1rem; border-radius: 6px; margin-bottom: 1.5rem; font-weight: 600; }
  .briefs { font-size: 0.95rem; color: #333; margin: 0 0 1rem; }
  .briefs a { margin-right: 0.75rem; }
</style>
</head>
<body>
<div class="ai-warning">Warning: this report's interpretations, matches, and summaries were generated by an LLM and may contain errors. Verify against the source papers before relying on any claim below.</div>

<h1>Paper Comparison Report</h1>
<p class="briefs">Short on time? Read the executive brief instead:
  <a href="brief_one_page.html">One-page brief</a>
  <a href="brief_abstract.html">Abstract</a>
  <a href="brief_decision_memo.html">Decision memo</a>
</p>

<h2>Objective metrics</h2>
<div class="metrics">
  <div class="metric"><div class="value">{{ comparison.metrics.word_count_a }} / {{ comparison.metrics.word_count_b }}</div><div class="label">word count (champion / challenger)</div></div>
  <div class="metric"><div class="value">{{ comparison.metrics.sentence_count_a }} / {{ comparison.metrics.sentence_count_b }}</div><div class="label">sentence count (champion / challenger)</div></div>
  <div class="metric"><div class="value">{{ "%.3f"|format(comparison.metrics.jaccard_similarity) }}</div><div class="label">whole-paper Jaccard similarity</div></div>
</div>

<details class="venn" open>
  <summary>Only in challenger <span class="count">({{ comparison.b_only|length }})</span></summary>
  {% for record in comparison.b_only %}
  <div class="record">
    <span class="quote b">{{ record.evidence[0] }}</span>
    <p class="interpretation">{{ record.interpretation }}</p>
  </div>
  {% else %}
  <p>Nothing found only in the challenger.</p>
  {% endfor %}
</details>

<details class="venn" open>
  <summary>Only in champion <span class="count">({{ comparison.a_only|length }})</span></summary>
  {% for record in comparison.a_only %}
  <div class="record">
    <span class="quote a">{{ record.evidence[0] }}</span>
    <p class="interpretation">{{ record.interpretation }}</p>
  </div>
  {% else %}
  <p>Nothing found only in the champion.</p>
  {% endfor %}
</details>

<details class="venn">
  <summary>Overlap (in both) <span class="count">({{ comparison.matched|length }})</span></summary>
  {% for record in comparison.matched %}
  <div class="record">
    <span class="quote a">Champion: {{ record.evidence[0] }}</span>
    <span class="quote b">Challenger: {{ record.evidence[1] }}</span>
    <p class="interpretation">{{ record.interpretation }}</p>
    {% if record.quote_similarity is not none %}
    <span class="similarity">quote similarity: {{ "%.2f"|format(record.quote_similarity) }}</span>
    {% endif %}
  </div>
  {% else %}
  <p>No matched assertions.</p>
  {% endfor %}
</details>

<h2>Assertions by section</h2>
<div class="two-col">
<div>
  <h3>Champion</h3>
  {% for section in comparison.paper_a_sections %}
  <div class="section">
    <h4>{{ section.header }}</h4>
    <p>{{ section.summary }}</p>
    {% for assertion in section.assertions %}
    <div class="assertion">
      <span class="type">{{ assertion.type }}</span>
      {% if not assertion.grounded %}<span class="badge ungrounded">ungrounded</span>{% endif %}
      {% if assertion.index_corrected %}<span class="badge corrected">index corrected</span>{% endif %}
      <p>{{ assertion.quote }}</p>
    </div>
    {% endfor %}
  </div>
  {% endfor %}
</div>
<div>
  <h3>Challenger</h3>
  {% for section in comparison.paper_b_sections %}
  <div class="section">
    <h4>{{ section.header }}</h4>
    <p>{{ section.summary }}</p>
    {% for assertion in section.assertions %}
    <div class="assertion">
      <span class="type">{{ assertion.type }}</span>
      {% if not assertion.grounded %}<span class="badge ungrounded">ungrounded</span>{% endif %}
      {% if assertion.index_corrected %}<span class="badge corrected">index corrected</span>{% endif %}
      <p>{{ assertion.quote }}</p>
    </div>
    {% endfor %}
  </div>
  {% endfor %}
</div>
</div>

</body>
</html>
